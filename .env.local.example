# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit secrets.
#
# Supabase deprecated anon/service_role naming in favour of
# sb_publishable_... / sb_secret_... keys. We keep the legacy env-var
# names below so @supabase/ssr picks them up unchanged: store your
# publishable key in NEXT_PUBLIC_SUPABASE_ANON_KEY and your secret key
# in SUPABASE_SERVICE_ROLE_KEY.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Daily.co
DAILY_API_KEY=

# Stripe Identity
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_xxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# Resend
RESEND_API_KEY=re_xxx

# PostHog (EU)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# App
APP_URL=http://localhost:3000
CRON_SECRET=
